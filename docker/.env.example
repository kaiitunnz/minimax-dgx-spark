# Configuration for the dual-DGX-Spark vLLM cluster.
# Copy to docker/.env and edit. The wrapper scripts pass this via
# --config docker/.env to third_party/spark-vllm-docker/run-recipe.sh.
# This file is gitignored (.env glob in .gitignore).
#
# Discovery on gx10-548e (2026-05-26):
#   - Head:   gx10-548e   (LAN 192.168.6.170)
#   - Worker: gx10-db5e   (LAN 192.168.6.171)
#   - Two RoCE fabrics: 192.168.100.0/24 and 192.168.200.0/24, four cables
#     across two ConnectX-7 cards per node.

# --- Cluster topology -------------------------------------------------------

# Comma-separated list of node IPs. First entry is the head node.
# Use LAN IPs that match the local detection on $ETH_IF — the launcher
# compares against the auto-detected local IP literally, so hostnames don't
# work here ("Local IP not in the list of nodes" error).
CLUSTER_NODES=192.168.6.170,192.168.6.171

# Control-plane NIC (used for Ray coordination and SSH). The LAN interface,
# not the RoCE interfaces.
ETH_IF=enP7s7

# RoCE NICs for NCCL. **HCA names** (from `ibdev2netdev`), NOT the matching
# netdev names — NCCL_IB_HCA is set literally from this and rejects netdev
# names with "NET/IB : No device found", silently falling back to Socket/TCP
# (10–20× slower).
#
# Full 4-cable mesh across both ConnectX-7 cards on both nodes:
IB_IF=rocep1s0f0,roceP2p1s0f0,rocep1s0f1,roceP2p1s0f1

# Ray master port (default 29501).
MASTER_PORT=29501

# --- Hugging Face -----------------------------------------------------------

# Host HF cache directory. The launcher mounts this at /root/.cache/huggingface
# inside the container. The DGX Spark stock setup uses /huggingface; ~/.bashrc
# also exports HF_HOME there. We read it from this file (not from shell env) so
# SSH-to-worker invocations use the same path as the head node.
HF_HOME=/huggingface

# --- Container env passthroughs (CONTAINER_* prefix) ----------------------
# The launcher forwards any CONTAINER_FOO=bar to the container as `-e FOO=bar`
# (the CONTAINER_ prefix is stripped).

# Hugging Face token for cyankiwi/MiniMax-M2.7-AWQ-4bit. The token is also in
# ~/.bashrc as HF_TOKEN, but SSH non-interactive sessions don't source it, so
# it must be set explicitly here for the container env.
CONTAINER_HF_TOKEN=

# In-container HF cache path. The launcher mounts the host's HF_HOME at
# /root/.cache/huggingface, so this matches that mount inside the container.
CONTAINER_HF_HOME=/root/.cache/huggingface

# Surface NCCL transport selection during first bring-up. Drop after Phase 3.
CONTAINER_NCCL_DEBUG=INFO

# Use DMA-BUF GPUDirect path on GB10. Falls back to CPU staging if unavailable.
CONTAINER_NCCL_DMABUF_ENABLE=1

# RoCE v2 GID index. NVIDIA's playbook value for DGX Spark.
CONTAINER_NCCL_IB_GID_INDEX=3

# Avoid CPU-affinity churn that can stall NCCL on Grace.
# (Also set by launch-cluster.sh defaults; kept here for visibility.)
CONTAINER_NCCL_IGNORE_CPU_AFFINITY=1
