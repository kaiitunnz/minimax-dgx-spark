{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/.config/opencode/opencode-style.md"
  ],
  "model": "vllm/cyankiwi/MiniMax-M2.7-AWQ-4bit",
  "small_model": "vllm/cyankiwi/MiniMax-M2.7-AWQ-4bit",
  "permission": {
    "*": "allow",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "task": "ask",
    "skill": "deny",
    "doom_loop": "deny",
    "external_directory": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": false
  },
  "agent": {
    "build": {
      "temperature": 1.0,
      "top_p": 0.95,
      "top_k": 40,
      "maxSteps": 8,
      "parse_tool_calls": true,
      "parallel_tool_calls": false
    },
    "plan": {
      "temperature": 1.0,
      "top_p": 0.95,
      "top_k": 40,
      "maxSteps": 4,
      "parse_tool_calls": true,
      "parallel_tool_calls": false
    }
  },
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM (DGX Spark Cluster)",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "timeout": 300000
      },
      "models": {
        "cyankiwi/MiniMax-M2.7-AWQ-4bit": {
          "name": "MiniMax M2.7 AWQ-4bit (vLLM TP=2)",
          "limit": {
            "context": 196608,
            "output": 8192
          }
        }
      }
    }
  }
}
